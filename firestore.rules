rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'ahmed123mhme22@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidProperty(data) {
      return data.keys().hasAll(['title', 'purpose', 'category', 'area', 'price', 'spaceM2', 'creatorUid']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.purpose in ['sale', 'rent'] &&
        data.category is string && data.category.size() <= 50 &&
        data.area is string && data.area.size() <= 50 &&
        data.price is number && data.price >= 0 &&
        data.spaceM2 is number && data.spaceM2 >= 0 &&
        data.creatorUid is string && data.creatorUid.size() <= 128;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['fullName', 'phone', 'inquiryType']) &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
        data.inquiryType in ['offer', 'request', 'consultation', 'property_inquiry'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 200 &&
        (isAdmin() || data.role in ['user', 'agent']); // Regular users cannot elevate to admin
    }

    // --- Properties Collection ---
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(propertyId) && isValidProperty(incoming()) && (incoming().creatorUid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(propertyId) && isValidProperty(incoming()) && (existing().creatorUid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(propertyId) && (existing().creatorUid == request.auth.uid || isAdmin());
    }

    // --- Inquiries (Client Leads & Consultations) ---
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // --- Master Platform Settings ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // --- Users Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // --- Administrators ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
